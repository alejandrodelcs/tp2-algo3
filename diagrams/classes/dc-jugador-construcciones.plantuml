@startuml


class Construccion{
    - propietario : Jugador
    - costo : Costo
    - vertice: Vertice
    + pagarCon(inventario:Inventario)
    + agregarPropietario(listaVictimas : List<Jugador>)
    + esAdyacenteA(Arista nueva): boolean
    + {abstract} producirSegun(dado:int):List<Recurso>

}


class Ciudad extends Construccion {
    +producirSegun(dado:int):List<Recurso>
}


class ConstruccionNula extends Construccion{
    +producirSegun(dado:int):List<Recurso>
}

class Poblado extends Construccion{
      +producirSegun(dado:int):List<Recurso>
}


class Carretera extends Construccion{
    -arista:Arista
    +producirSegun(dado:int):List<Recurso>
    +esAdyacenteA(otra:Arista):boolean

}


class Jugador{
 -nombre:String
 -cartasDesarrollo: List<CartaDesarrollo>
 -puntosVictoria: int
 +construir(vertice:Vertice, construccion:Construccion)
 +robarAR(victima:Jugador)
 +recibirRecurso(recurso:Recurso)
 +entregarRecursoA(ladron:Jugador)
}


Jugador "1" o-- "*" Construccion

@enduml